# Netlify header rules — https://docs.netlify.com/routing/headers/
#
# Everything under /assets/ carries a Vite content hash in its filename, so the same
# URL can never serve different bytes: cache it forever. Netlify's default of
# max-age=0,must-revalidate made every page view re-validate ~30 chunks with 304
# round-trips for no benefit. index.html is deliberately NOT listed here — it is the
# one file whose URL stays the same while its contents change, and the default
# revalidation is exactly right for it.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The hero encodes are large and effectively immutable (a re-encode gets a new
# README entry and deliberate cache-bust). A year of cache keeps repeat visits from
# re-pulling 44 MB.
/hero/*
  Cache-Control: public, max-age=31536000
